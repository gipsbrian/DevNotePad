# Default token/org used when a dashboard doesn't supply its own. Only the
# first account (the ADMIN_* one below) falls back to these; accounts
# created later never see them and add a token of their own in the app.
# When creating this token, scope it to specific repos, Issues: Read-only
# (or Read & write only if you want to close issues / post comments),
# Metadata: Read-only. Never grant full `repo` or org-wide access.
GIT_TOKEN=
GIT_ORG_URL=

# Encrypts the GitHub tokens the app stores in its database. Required.
# `make setup` generates one; to make your own:
#   python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
# Changing it makes already-stored tokens unreadable (re-enter them in the app).
SECRET_KEY=

# The account you sign in with, created on first startup and only ever
# into an empty user table — editing these later won't change an existing
# account's password. Without all three, nobody can sign in.
ADMIN_USERNAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# People can create their own accounts from the sign-in page; a new account
# joins only the main organisation. Anyone who can reach the page can sign
# up, so set this to false to close sign-up.
# ALLOW_REGISTRATION=false

# Where people reach the app, e.g. https://devnotepad.example.com. Needed
# for single sign-on: provider callback URLs are built from it. Providers
# themselves are configured per organisation in the app.
# PUBLIC_URL=

# Marks the session cookie Secure. Turn on wherever the app is served over
# HTTPS; leave off for plain http://localhost or the session won't stick.
# SESSION_HTTPS_ONLY=true

# Hostnames a reverse proxy serves the app on, comma-separated. The dev
# server refuses unknown Host headers without this.
# VITE_ALLOWED_HOSTS=boards.example.com

# Where the browser should reach the API. Leave unset for the normal
# setup (the browser calls the backend on its own host port). Set it
# empty behind a reverse proxy that serves the API on the same origin,
# so the app uses relative /api paths instead.
# VITE_API_BASE_URL=

# Where the API lives, when it isn't on the same address as the app (the
# plain local Docker setup). Defaults to PUBLIC_URL.
# PUBLIC_API_URL=

# The SQLite file, and which origins may call the API from a browser.
# Docker Compose sets both; change them only for a hand-rolled setup.
# DATABASE_PATH=./data/devnotepad.db
# CORS_ORIGINS=["http://localhost:5180"]

# Optional: host ports for `make dev` / `make docker-up`.
# Defaults avoid the common 8000/5173 clash with other local services.
# BACKEND_PORT=8010
# FRONTEND_PORT=5180
